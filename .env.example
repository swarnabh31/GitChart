# Copy to .env and fill in required values.

# --- Required for full stack ---------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=https://<bucket>.<account>.r2.cloudflarestorage.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
OPENAI_API_KEY=
AI_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
AI_EXPLANATION_MODEL=
AI_DIAGRAM_MODEL=

# --- OpenRouter (only when AI_PROVIDER=openrouter) ------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Ollama (local, only when AI_PROVIDER=ollama) -------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b

# --- Generation rate limiting ---------------------------------------------
GENERATION_RATE_LIMIT_MAX=10
GENERATION_RATE_LIMIT_WINDOW_SECONDS=3600

# --- GitHub ----------------------------------------------------------------
GITHUB_PAT=
GITHUB_PATS=
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=

# --- PostHog analytics ------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com

# --- Testing safety ---------------------------------------------------------
# Must be "1" for any test that writes to live R2/Redis storage.
ALLOW_LIVE_STORAGE_IN_TESTS=
